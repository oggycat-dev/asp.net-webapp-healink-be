# Database Configuration
CONNECTION_STRING=Server=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ISSUER=Healink
JWT_AUDIENCE=HealinkUsers
JWT_EXPIRES_IN_MINUTES=60

# Admin Account Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# CORS Configuration
FRONTEND_URL=http://localhost:3000
CORS_ALLOW_ANY_ORIGIN=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,https://localhost:3000,https://localhost:4200

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Storage Configuration (Local by default)
STORAGE_PROVIDER_TYPE=LocalStorage
LOCAL_STORAGE_ROOT_PATH=wwwroot/uploads
LOCAL_STORAGE_MAX_FILE_SIZE=10485760
LOCAL_STORAGE_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.bmp,.pdf,.doc,.docx,.xls,.xlsx,.txt

# Security
REQUIRE_HTTPS=false 